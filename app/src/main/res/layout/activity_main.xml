<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/AppScreen">

    <TextView
        style="@style/AppHeading"
        android:text="Folder pairs" />

    <ListView
        android:id="@+id/pairList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp" />

    <TextView
        android:id="@+id/emptyState"
        style="@style/AppEmptyState"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="No folder pairs yet.\nAdd one to start syncing." />

    <TextView
        android:id="@+id/status"
        style="@style/AppStatus"
        android:maxLines="10"
        android:ellipsize="end" />

    <Button
        android:id="@+id/addPair"
        style="@style/AppButton"
        android:layout_marginTop="16dp"
        android:text="Add folder pair" />

    <Button
        android:id="@+id/syncAll"
        style="@style/AppButton"
        android:text="Sync all" />

</LinearLayout>
