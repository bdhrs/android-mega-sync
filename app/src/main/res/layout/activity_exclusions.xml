<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/AppScreen">

    <TextView
        style="@style/AppHeading"
        android:text="Exclusions" />

    <ListView
        android:id="@+id/exclusionList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp" />

    <TextView
        android:id="@+id/emptyState"
        style="@style/AppEmptyState"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="Nothing excluded.\nBrowse a side to leave folders out of the sync." />

    <Button
        android:id="@+id/browseSource"
        style="@style/AppButton"
        android:layout_marginTop="16dp"
        android:text="Browse local" />

    <Button
        android:id="@+id/browseDestination"
        style="@style/AppButton"
        android:text="Browse MEGA" />

</LinearLayout>
